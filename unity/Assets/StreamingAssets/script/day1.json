      "choices": [
        {
          "text": "다 얘기할게.",
          "effects": {
            "deviation": 1,
            "stability": 1
          },
          "next": "d1_evening_listen"
        },
        {
          "text": "얘기하기 싫어.",
          "effects": {
            "stability": -1
